{
  "name": "numany-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:tenant": "ng serve tenant-numany --port 4500 --host 0.0.0.0 --disable-host-check",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:main-numany": "jest projects/main-numany",
    "test:tenant-numany": "jest projects/tenant-numany",
    "test:shared-ui": "jest projects/shared-ui",
    "format": "prettier --write \"projects/**/*.{ts,html,scss,css,json,md}\""
  },
  "private": true,
  "dependencies": {
    "@angular-builders/jest": "^19.0.1",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@ngrx/signals": "^19.2.1",
    "@primeng/themes": "^19.1.3",
    "jwt-decode": "^4.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^19.1.3",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.11",
    "tailwindcss-primeui": "^0.6.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.15",
    "@angular/cli": "^19.2.0",
    "@angular/compiler-cli": "^19.2.0",
    "@tailwindcss/postcss": "^4.1.10",
    "@types/jasmine": "~5.1.0",
    "@types/jest": "^30.0.0",
    "autoprefixer": "^10.4.21",
    "jasmine-core": "~5.6.0",
    "jest": "^29.7.0",
    "jest-preset-angular": "^14.6.0",
    "ng-packagr": "^19.2.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "typescript": "~5.7.2"
  }
}
